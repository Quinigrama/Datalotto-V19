# .env.example
# Credenciales de Telegram para el formulario de contacto (Obligatorio para que funcione)
TELEGRAM_BOT_TOKEN=tu-token-de-bot-de-telegram
TELEGRAM_CHAT_ID=tu-id-de-chat-o-canal-de-telegram

# API Key de Gemini para el asistente de filtros IA
GEMINI_API_KEY=

# URL del Web App de Google Apps Script para enviar las estadísticas a Google Sheets
GOOGLE_SHEETS_WEBAPP_URL=

